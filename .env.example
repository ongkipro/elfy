# ==========================================
# ELFY.MY — Environment Configuration Template
# ==========================================

# 1. Shopify Storefront API Credentials
# Store domain format: <store-id>.myshopify.com
PUBLIC_STORE_DOMAIN="vvxgev-3p.myshopify.com"

# Public Storefront API token generated in Headless Sales Channel
PUBLIC_STOREFRONT_API_TOKEN=""

# Storefront API version (recommended: 2025-01 or 2026-04)
PUBLIC_STOREFRONT_API_VERSION="2025-01"

# Private Storefront API token for server-side queries (Oxygen/Workers)
PRIVATE_STOREFRONT_API_TOKEN=""

# Shopify Admin API token (Restricted to server-side only for webhooks/sync)
SHOPIFY_ADMIN_API_TOKEN=""

# 2. Session & Security
# 32+ character random string for signing session cookies
SESSION_SECRET=""

# 3. Marketing & Attribution Signals
# Meta Pixel ID (Browser Tracking)
PUBLIC_META_PIXEL_ID=""

# Meta Conversions API (CAPI) Server Access Token
META_CAPI_ACCESS_TOKEN=""

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=""

# Google Ads Conversion ID / GA4 Measurement ID
PUBLIC_GA4_MEASUREMENT_ID=""

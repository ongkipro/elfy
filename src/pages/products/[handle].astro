---
import Layout from '../../layouts/Layout.astro';
import { getProductByHandle, getProducts } from '../../lib/shopify/client';
import { ProductGallery } from '../../components/product/ProductGallery';
import { ShoeProductDetail } from '../../components/product/ShoeProductDetail';
import { WatchProductDetail } from '../../components/product/WatchProductDetail';
import { StickyAddToCart } from '../../components/product/StickyAddToCart';
import ProductCard from '../../components/product/ProductCard.astro';
import { ArrowRight } from '@lucide/astro';

const { handle = '' } = Astro.params;
const product = await getProductByHandle(handle);

if (!product) {
  return Astro.redirect('/collections/all');
}

const title = product.title;
const isShoe = product.productType === 'Shoes';
const isWatch = product.productType === 'Watches';

// Cross-selling recommendations
const allProducts = await getProducts();
const relatedProducts = allProducts
  .filter((p) => p.handle !== product.handle && (isShoe ? p.productType === 'Watches' : p.productType === 'Shoes'))
  .slice(0, 4);

// JSON-LD Schema for Google Rich Results
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  image: product.featuredImage.url,
  description: title,
  brand: {
    '@type': 'Brand',
    name: 'VELLUM',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'MYR',
    price: product.priceRange.minVariantPrice.amount,
    availability: product.availableForSale ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
---

<Layout title={`${title} | VELLUM Malaysia`} description={`${title} - VELLUM Kuala Lumpur`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Breadcrumbs Bar -->
  <div class="bg-[#F7F4EC]/60 border-b border-[#E8E3DA] py-3 sm:py-3.5">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 text-[10px] sm:text-[11px] text-neutral-500 uppercase tracking-widest flex items-center gap-2 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-neutral-950 transition-colors">VELLUM</a>
      <span>/</span>
      <a href={`/collections/${isShoe ? 'shoes' : 'watches'}`} class="hover:text-neutral-950 transition-colors">
        {isShoe ? 'Footwear' : 'Timepieces'}
      </a>
      <span>/</span>
      <span class="text-neutral-900 font-bold truncate max-w-xs">{title}</span>
    </div>
  </div>

  <!-- PDP Main Grid -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <!-- Left: Interactive Gallery Island (7 Columns) -->
      <div class="lg:col-span-7">
        <ProductGallery client:load images={product.images.nodes} title={title} />
      </div>

      <!-- Right: Specialized Shoe or Watch Commerce Detail Panel (5 Columns) -->
      <div class="lg:col-span-5">
        {isShoe ? (
          <ShoeProductDetail client:load product={product} />
        ) : (
          <WatchProductDetail client:load product={product} />
        )}
      </div>
    </div>
  </div>

  <!-- Related Pair-With Recommendations Section: 2 COLUMNS ON MOBILE -->
  {relatedProducts.length > 0 && (
    <section class="border-t border-[#E8E3DA] bg-[#F7F4EC]/40 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 sm:mb-8 gap-2">
          <div>
            <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] text-[#B89768] block mb-1">
              Padanan Gaya Sempurna
            </span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-950">
              {isShoe ? 'Padankan dengan Jam Tangan' : 'Padankan dengan Kasut VELLUM'}
            </h2>
          </div>

          <a
            href={`/collections/${isShoe ? 'watches' : 'shoes'}`}
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-[#B89768] hover:text-[#917349] transition-colors"
          >
            <span>Lihat Semua</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Mobile Floating Sticky Add to Bag Bar -->
  <StickyAddToCart client:idle product={product} />
</Layout>
